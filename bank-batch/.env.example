POSTGRES_DB=banco
POSTGRES_USER=TU_USUARIO
POSTGRES_PASSWORD=TU_PASSWORD

KEYCLOAK_ADMIN=TU_ADMIN
KEYCLOAK_ADMIN_PASSWORD=TU_PASSWORD_ADMIN

SSL_KEYSTORE_PASSWORD=changeit

# EC2: reemplazar localhost por la IP publica o el dominio, sin protocolo ni puerto.
# Keycloak y las API usan https://PUBLIC_HOST:8081/realms/banco como emisor.
PUBLIC_HOST=localhost
