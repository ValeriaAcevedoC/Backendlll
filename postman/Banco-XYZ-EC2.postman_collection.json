    {
      "name": "1. Obtener tokens",
      "description": "Enviar los tres POST. Cada petición guarda su token en una variable de colección.",
      "item": [
        {
          "name": "Token web",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              }
            ],
            "url": "https://{{host}}:8081/realms/banco/protocol/openid-connect/token",
            "description": "Usuario de demostración web. Guarda automáticamente access_token en token_web. Si el token vence, reenviar esta petición.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "key": "client_id",
                  "value": "bank-batch-client",
                  "type": "text"
                },
                {
                  "key": "grant_type",
                  "value": "password",
                  "type": "text"
                },
                {
                  "key": "username",
                  "value": "web",
                  "type": "text"
                },
                {
                  "key": "password",
                  "value": "web123",
                  "type": "text"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Keycloak devuelve HTTP 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.test('La respuesta contiene access_token', function () {",
                  "    pm.expect(data.access_token).to.be.a('string').and.not.empty;",
                  "  });",
                  "  if (data.access_token) pm.collectionVariables.set('token_web', data.access_token);",
                  "}"
                ]
              }
            }
          ]
        },
